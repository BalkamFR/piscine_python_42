// --- NOUVEAU : Récupération automatique des postes avec l'étoile ---
const greyPostes = {};
// On cherche toutes les cartes qui ont fait l'animation de retournement (qui affichent l'étoile)
document.querySelectorAll('.content.rotate-y-180').forEach(el => {
    const host = el.closest('[id]');
    if (host && host.id) {
        // On récupère le temps s'il fait partie de nos listes pour continuer à l'afficher
        const time = greenPostes[host.id] || bluePostes[host.id] || orangePostes[host.id] || redPostes[host.id] || null;
        greyPostes[host.id] = time;
    }
});

// Création d'une feuille de style dynamique
const style = document.createElement('style');
style.id = 'custom-cluster-highlight';

// Fonction pour générer le CSS pour chaque catégorie
const generateCSS = (postes, bgColor, borderColor, shadowColor, showTime = false) => {
    const isArray = Array.isArray(postes);
    const entries = isArray ? postes.map(id => [id, null]) : Object.entries(postes);
    
    return entries.map(([id, time]) => `
        #${id} { 
            opacity: 1 !important; 
            transform: scale(1.1) !important; 
            z-index: 50 !important; 
            box-shadow: 0 10px 25px -5px ${shadowColor} !important;
            position: relative !important;
        }
        #${id} > div > div > div { background-color: ${bgColor} !important; border: 2px solid ${borderColor} !important; }
        #${id} p { color: #ffffff !important; font-weight: 800 !important; }
        #${id} svg { color: #ffffff !important; }
        
        ${showTime && time ? `
        /* Ajout de l'étiquette de temps en haut de la vignette (sans déborder) */
        #${id}::after {
            content: "${time}";
            position: absolute;
            top: 43px;
            left: 50%;
            transform: translateX(-50%); 
            background-color: #111827;
            color: #ffffff;
            font-size: 11px;
            font-weight: 900;
            padding: 3px 8px;
            border-radius: 4px;
            white-space: nowrap;
            z-index: 100 !important;
            box-shadow: 0 2px 5px rgba(0,0,0,0.5);
            border: 1px solid ${bgColor};
            pointer-events: none;
        }
        ` : ''}
    `).join('');
};

// Injection des règles CSS
style.innerHTML = `
  /* Postes >= 3h42 (Vert) */
  ${generateCSS(greenPostes, '#22c55e', '#14532d', 'rgba(34, 197, 94, 0.5)', true)}

  /* Postes Manque <= 1h (Bleu) */
  ${generateCSS(bluePostes, '#3b82f6', '#1e3a8a', 'rgba(59, 130, 246, 0.5)', true)}

  /* Postes Manque <= 2h (Orange) */
  ${generateCSS(orangePostes, '#f97316', '#7c2d12', 'rgba(249, 115, 22, 0.5)', true)}

  /* Reste (Rouge) */
  ${generateCSS(redPostes, '#ef4444', '#7f1d1d', 'rgba(239, 68, 68, 0.5)', true)}

  /* Postes DÉJÀ PRIS (Gris) - Placé en tout dernier pour écraser les autres couleurs automatiquement */
  ${generateCSS(greyPostes, '#6b7280', '#374151', 'rgba(107, 114, 128, 0.5)', true)}
`;

// Application des styles à la page
